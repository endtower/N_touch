<UserControl x:Class="AbyssLauncher.ComponentUpdateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- 行下方那条状态细线：一句更新状态；正在下载时再接一条进度 -->
        <TextBlock x:Name="Message" Text="等待检查版本"
                   Style="{StaticResource TextValue}"
                   FontSize="{DynamicResource FontSizeXs}"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                   Margin="18,5,0,0"/>
        <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="3"
                     Visibility="Collapsed" Margin="18,5,0,0"/>

        <!-- 展开出来的那一行：改更新源、导入本地包 -->
        <Grid x:Name="SourceRow" Visibility="Collapsed" VerticalAlignment="Center" Margin="18,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="更新源" Style="{StaticResource TextLabel}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="SourceBox"
                     ToolTip="组件版本清单或版本列表的 HTTPS 地址；留空则关闭本组件的在线检查"/>
            <Button Grid.Column="2" x:Name="SaveSourceButton" Content="保存" Style="{StaticResource GhostButton}"
                    Margin="8,0,0,0" Click="SaveSource_Click"/>
            <Button Grid.Column="3" x:Name="ImportButton" Content="导入本地包" Style="{StaticResource GhostButton}"
                    Margin="8,0,0,0" Click="Import_Click"/>
        </Grid>
    </StackPanel>
</UserControl>
