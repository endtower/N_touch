<Window x:Class="AbyssLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Abyss 桌面启动管理器" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen" Background="#1E293B"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button" x:Key="NavBtn">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 导航 -->
        <StackPanel Grid.Column="0" Background="#0F172A">
            <TextBlock Text="Abyss 管家" FontSize="18" FontWeight="Bold" Foreground="#A5B4FC"
                       Margin="16,18,0,10"/>
            <Button x:Name="NavOverview" Style="{StaticResource NavBtn}" Foreground="White"
                    Content="总览与控制" Click="Nav_Click" Tag="overview"/>
            <Button x:Name="NavCoreWeb" Style="{StaticResource NavBtn}" Foreground="#CBD5E1"
                    Content="主程序配置 (网页)" Click="Nav_Click" Tag="coreweb"/>
            <Button x:Name="NavSnowluma" Style="{StaticResource NavBtn}" Foreground="#CBD5E1"
                    Content="SnowLuma 配置" Click="Nav_Click" Tag="snowluma"/>
            <Button x:Name="NavLogs" Style="{StaticResource NavBtn}" Foreground="#CBD5E1"
                    Content="日志" Click="Nav_Click" Tag="logs"/>
            <Button x:Name="NavUpdate" Style="{StaticResource NavBtn}" Foreground="#CBD5E1"
                    Content="更新" Click="Nav_Click" Tag="update"/>
            <StackPanel Margin="16,20,8,0">
                <TextBlock Text="服务状态" Foreground="#64748B" FontSize="11"/>
                <TextBlock x:Name="ServiceStateText" Foreground="#F87171" FontSize="13" Margin="0,4,0,0"
                           Text="连接中…"/>
                <TextBlock Text="Core 状态" Foreground="#64748B" FontSize="11" Margin="0,12,0,0"/>
                <TextBlock x:Name="CoreStateText" Foreground="#F87171" FontSize="13" Margin="0,4,0,0"
                           Text="—"/>
                <TextBlock Text="SnowLuma 状态" Foreground="#64748B" FontSize="11" Margin="0,12,0,0"/>
                <TextBlock x:Name="SnowlumaStateText" Foreground="#F87171" FontSize="13" Margin="0,4,0,0"
                           Text="—"/>
            </StackPanel>
        </StackPanel>

        <!-- 内容区 -->
        <Grid Grid.Column="1">
            <!-- 总览 -->
            <ScrollViewer x:Name="OverviewPanel" Visibility="Visible">
                <StackPanel Margin="24">
                    <TextBlock Text="总览与控制" FontSize="20" Foreground="White" Margin="0,0,0,16"/>
                    <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Abyss Core（大脑 + 网页）" FontSize="15" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="CoreDetail" Foreground="#94A3B8" Margin="0,6,0,10" Text="—"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="启动" Padding="14,6" Margin="0,0,8,0" Click="CoreStart_Click"/>
                                <Button Content="停止（优雅）" Padding="14,6" Margin="0,0,8,0" Click="CoreStop_Click"/>
                                <Button Content="重启" Padding="14,6" Click="CoreRestart_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SnowLuma（QQ 登录）" FontSize="15" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="SnowlumaDetail" Foreground="#94A3B8" Margin="0,6,0,10" Text="—"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="启动" Padding="14,6" Margin="0,0,8,0" Click="SnowlumaStart_Click"/>
                                <Button Content="停止" Padding="14,6" Margin="0,0,8,0" Click="SnowlumaStop_Click"/>
                                <Button Content="打开 WebUI" Padding="14,6" Click="SnowlumaWebui_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="启动全部" Padding="14,6" Margin="0,0,8,0" Click="StartAll_Click"/>
                        <Button Content="停止全部" Padding="14,6" Click="StopAll_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- WebView2（主程序配置 / SnowLuma） -->
            <Grid x:Name="WebPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#0F172A" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="WebTabCore" Content="主程序配置 (Core :5002)" Padding="10,5" Margin="0,0,8,0" Click="WebTabCore_Click"/>
                        <Button x:Name="WebTabSnowluma" Content="SnowLuma WebUI (:5099)" Padding="10,5" Click="WebTabSnowluma_Click"/>
                        <TextBlock x:Name="WebOverlayHint" Foreground="#FBBF24" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Text="目标未运行——可在「总览」启动" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <wv2:WebView2 x:Name="Web" Grid.Row="1"/>
            </Grid>

            <!-- 日志 -->
            <Grid x:Name="LogsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="24,20,24,8">
                    <ComboBox x:Name="LogSource" Width="220" SelectedIndex="0" SelectionChanged="LogSource_Changed">
                        <ComboBoxItem Content="Core 主日志" Tag="core"/>
                        <ComboBoxItem Content="Core 启动输出" Tag="core_out"/>
                        <ComboBoxItem Content="SnowLuma 输出" Tag="snowluma"/>
                        <ComboBoxItem Content="管理服务" Tag="service"/>
                    </ComboBox>
                    <Button Content="刷新" Padding="12,5" Margin="12,0,0,0" Click="LogRefresh_Click"/>
                </StackPanel>
                <TextBox x:Name="LogBox" Grid.Row="1" Margin="24,0,24,20" Background="#0B1220" Foreground="#CBD5E1"
                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- 更新（阶段 E 占位） -->
            <StackPanel x:Name="UpdatePanel" Visibility="Collapsed" Margin="24">
                <TextBlock Text="更新" FontSize="20" Foreground="White" Margin="0,0,0,12"/>
                <TextBlock Foreground="#94A3B8" TextWrapping="Wrap"
                           Text="本地导入更新包（清单 + 校验 + 失败回滚）在阶段 E 实现；在线来源不在验证版范围。"/>
            </StackPanel>

            <!-- 状态栏 -->
            <Border VerticalAlignment="Bottom" Background="#0F172A" Padding="12,6">
                <TextBlock x:Name="StatusBar" Foreground="#94A3B8" FontSize="12" Text="就绪"/>
            </Border>
        </Grid>
    </Grid>
</Window>
