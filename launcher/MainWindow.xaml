<Window x:Class="AbyssLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Abyss 桌面启动管理器" Height="760" Width="1180" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="#1E293B"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button" x:Key="NavBtn">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 导航 -->
        <StackPanel Grid.Column="0" Background="#0F172A">
            <TextBlock Text="Abyss 管家" FontSize="18" FontWeight="Bold" Foreground="#A5B4FC"
                       Margin="16,18,0,10"/>
            <Button x:Name="NavOverview" Style="{StaticResource NavBtn}" Foreground="White"
                    Content="总览与控制" Click="Nav_Click" Tag="overview"/>
            <Button x:Name="NavCoreWeb" Style="{StaticResource NavBtn}" Foreground="#CBD5E1"
                    Content="Core 页面" Click="Nav_Click" Tag="coreweb"/>
            <Button x:Name="NavSnowluma" Style="{StaticResource NavBtn}" Foreground="#CBD5E1"
                    Content="SnowLuma 页面" Click="Nav_Click" Tag="snowluma"/>
            <Button x:Name="NavLogs" Style="{StaticResource NavBtn}" Foreground="#CBD5E1"
                    Content="日志" Click="Nav_Click" Tag="logs"/>
            <StackPanel Margin="16,20,8,0">
                <TextBlock Text="服务状态" Foreground="#64748B" FontSize="11"/>
                <TextBlock x:Name="ServiceStateText" Foreground="#F87171" FontSize="13" Margin="0,4,0,0"
                           Text="连接中…"/>
                <TextBlock Text="Core 状态" Foreground="#64748B" FontSize="11" Margin="0,12,0,0"/>
                <TextBlock x:Name="CoreStateText" Foreground="#F87171" FontSize="13" Margin="0,4,0,0"
                           Text="—"/>
                <TextBlock Text="SnowLuma 状态" Foreground="#64748B" FontSize="11" Margin="0,12,0,0"/>
                <TextBlock x:Name="SnowlumaStateText" Foreground="#F87171" FontSize="13" Margin="0,4,0,0"
                           Text="—"/>
            </StackPanel>
        </StackPanel>

        <!-- 内容区 -->
        <Grid Grid.Column="1" Margin="0,0,0,32">
            <!-- 总览 -->
            <ScrollViewer x:Name="OverviewPanel" Visibility="Visible">
                <StackPanel Margin="24">
                    <TextBlock Text="总览与控制" FontSize="20" Foreground="White" Margin="0,0,0,16"/>
                    <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Abyss Core（大脑 + 网页）" FontSize="15" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="CoreDetail" Foreground="#94A3B8" Margin="0,6,0,10" Text="—"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="启动" Padding="14,6" Margin="0,0,8,0" Click="CoreStart_Click"/>
                                <Button Content="停止（优雅）" Padding="14,6" Margin="0,0,8,0" Click="CoreStop_Click"/>
                                <Button Content="重启" Padding="14,6" Click="CoreRestart_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="SnowLuma（QQ 登录）" FontSize="15" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="SnowlumaDetail" Foreground="#94A3B8" Margin="0,6,0,10" Text="—"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="启动" Padding="14,6" Margin="0,0,8,0" Click="SnowlumaStart_Click"/>
                                <Button Content="停止" Padding="14,6" Margin="0,0,8,0" Click="SnowlumaStop_Click"/>
                                <Button Content="打开页面" Padding="14,6" Click="SnowlumaWebui_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="启动全部" Padding="14,6" Margin="0,0,8,0" Click="StartAll_Click"/>
                        <Button Content="停止全部" Padding="14,6" Click="StopAll_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- WebView2（主程序配置 / SnowLuma） -->
            <Grid x:Name="WebPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#0F172A" Padding="10,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="刷新页面" Padding="14,6" Click="WebRefresh_Click"/>
                        <StackPanel>
                            <TextBlock x:Name="WebPageTitle" Text="Core 页面" Foreground="White" FontSize="16"/>
                            <TextBlock x:Name="WebPageState" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
                    <Border x:Name="WebUnavailable" Background="#0B1220" Padding="32">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                            <TextBlock x:Name="WebUnavailableTitle" Text="等待连接" Foreground="White" FontSize="22" TextAlignment="Center"/>
                            <TextBlock x:Name="WebUnavailableDetail" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,12,0,20" TextAlignment="Center"/>
                            <Button x:Name="WebStartButton" Content="启动程序" Padding="20,8" HorizontalAlignment="Center" Click="WebStart_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 日志 -->
            <Grid x:Name="LogsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="24,20,24,8">
                    <Button x:Name="LogTabCore" Content="Core" Tag="core" Padding="18,7" Click="LogTab_Click"/>
                    <Button x:Name="LogTabSnowluma" Content="SnowLuma" Tag="snowluma" Padding="18,7" Margin="8,0,0,0" Click="LogTab_Click"/>
                    <Button x:Name="LogTabService" Content="管理服务" Tag="service" Padding="18,7" Margin="8,0,0,0" Click="LogTab_Click"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="24,0,24,10">
                    <CheckBox x:Name="LogAuto" Content="自动更新" IsChecked="True" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox x:Name="LogFollow" Content="跟随最新" IsChecked="True" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="搜索" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="LogSearch" Width="150" ToolTip="筛选日志内容" TextChanged="LogSearch_Changed" Margin="0,0,8,0"/>
                    <Button Content="刷新" Padding="10,5" Click="LogRefresh_Click" Margin="0,0,8,0"/>
                    <Button Content="复制" Padding="10,5" Click="LogCopy_Click" Margin="0,0,8,0"/>
                    <Button Content="打开日志目录" Padding="10,5" Click="LogFolder_Click"/>
                </WrapPanel>
                <RichTextBox x:Name="LogBox" Grid.Row="2" Margin="24,0,24,8" Background="#0B1220" Foreground="#CBD5E1"
                         FontFamily="Consolas" FontSize="12" IsReadOnly="True" IsDocumentEnabled="False" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="LogInfo" Grid.Row="3" Foreground="#94A3B8" Margin="24,0,24,12" TextWrapping="Wrap"/>
            </Grid>

        </Grid>
        <Border Grid.Column="1" VerticalAlignment="Bottom" Background="#0F172A" Padding="12,6">
            <TextBlock x:Name="StatusBar" Foreground="#94A3B8" FontSize="12" Text="就绪"/>
        </Border>
    </Grid>
</Window>
