<Window x:Class="AbyssLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AbyssLauncher"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Abyss 桌面启动管理器" Height="760" Width="1180" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource FontSans}"
        FontSize="{DynamicResource FontSizeBase}"
        Background="{DynamicResource BrushBgApp}"
        Closing="Window_Closing">

    <!-- 自绘标题栏（Codex 式）：去掉系统标题栏，− □ × 内嵌进应用自己的一条栏。
         CaptionHeight=40 让这条栏自动具备拖动与双击最大化；栏内需要接收点击的
         控件必须标 WindowChrome.IsHitTestVisibleInChrome="True"。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 窗口按钮图标：描边式，和轨道图标同一套画法 -->
        <StreamGeometry x:Key="GlyphMinimize">M0,6 H12</StreamGeometry>
        <StreamGeometry x:Key="GlyphMaximize">M0.5,0.5 H11.5 V11.5 H0.5 Z</StreamGeometry>
        <StreamGeometry x:Key="GlyphRestore">M3.5,0.5 H11.5 V8.5 M0.5,3.5 H8.5 V11.5 H0.5 Z</StreamGeometry>
        <StreamGeometry x:Key="GlyphClose">M0.5,0.5 L11.5,11.5 M11.5,0.5 L0.5,11.5</StreamGeometry>
        <!-- 设置：两条带旋钮的滑杆 -->
        <StreamGeometry x:Key="GlyphSliders">M3,8 H21 M3,16 H21 M9,6 A2,2 0 1 1 8.99,6 Z M15,14 A2,2 0 1 1 14.99,14 Z</StreamGeometry>
    </Window.Resources>

    <!-- 1px 外框：WindowStyle=None 之后没有系统边框，靠这层定义窗口边缘 -->
    <Border BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- 自绘标题栏 -->
                <RowDefinition Height="*"/>    <!-- 主体（含它自己的状态栏行） -->
            </Grid.RowDefinitions>

            <!-- ============================================================
                 标题栏
                 ============================================================ -->
            <Grid Grid.Row="0" Background="{DynamicResource BrushBgSurface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                    <local:ChamferBorder Width="18" Height="18" Chamfer="5" Corners="Diagonal"
                                         Background="{DynamicResource BrushAccent}"
                                         VerticalAlignment="Center">
                        <TextBlock Text="A" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextOnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </local:ChamferBorder>
                    <TextBlock Text="Abyss 桌面启动管理器" Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <!-- 构建时间戳水印：存在多份同名 EXE 时，据此辨认当前运行的是哪一次构建 -->
                    <TextBlock x:Name="BuildStampText" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{DynamicResource BrushTextTertiary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 刷新当前网页。放在标题栏里，永远可见 ——
                         比"悬停浮出"那套稳得多：不涉及 Popup、不涉及 WebView2 的层级问题。 -->
                    <Button x:Name="BtnRefreshWeb" Style="{StaticResource WindowButton}"
                            Margin="0,0,4,0"
                            ToolTip="刷新当前网页" Click="RefreshWeb_Click">
                        <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconRefresh}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>

                    <Button x:Name="BtnSettings" Style="{StaticResource WindowButton}"
                            Margin="0,0,4,0"
                            ToolTip="设置" Click="Settings_Click">
                        <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource GlyphSliders}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>

                    <Border Width="1" Height="18" Margin="2,0,4,0"
                            Background="{DynamicResource BrushBorderSubtle}"/>

                    <Button x:Name="BtnMinimize" Style="{StaticResource WindowButton}"
                            ToolTip="最小化" Click="Minimize_Click">
                        <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource GlyphMinimize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource WindowButton}"
                            ToolTip="最大化" Click="MaximizeRestore_Click">
                        <Path x:Name="MaximizeGlyph" Width="12" Height="12" Stretch="Uniform"
                              Data="{StaticResource GlyphMaximize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}"
                            ToolTip="关闭（隐藏到托盘，后台继续运行）" Click="Close_Click">
                        <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource GlyphClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>

                <!-- 设置面板。StaysOpen=False：点面板外面自动收起，不需要任何自己写的开合逻辑。 -->
                <Popup x:Name="SettingsPopup"
                       PlacementTarget="{Binding ElementName=BtnSettings}"
                       Placement="Bottom"
                       HorizontalOffset="-186"
                       VerticalOffset="2"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource BrushBgRaised}"
                            BorderBrush="{DynamicResource BrushBorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusLg}"
                            Padding="14,12"
                            Margin="8">
                        <StackPanel Width="228">
                            <TextBlock Text="点标题栏 × 时" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeMd}"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,10"/>
                            <RadioButton x:Name="SetCloseToTray" GroupName="CloseBehavior"
                                         Style="{StaticResource SegmentedTab}"
                                         Content="隐藏到托盘（后台继续运行）"
                                         Checked="CloseBehavior_Changed"/>
                            <RadioButton x:Name="SetCloseExit" GroupName="CloseBehavior"
                                         Style="{StaticResource SegmentedTab}"
                                         Content="退出程序（停止 Core 与 SnowLuma）"
                                         Checked="CloseBehavior_Changed"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- ============================================================
                 主体
                 ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>                        <!-- 最左图标轨道 -->
                    <ColumnDefinition x:Name="SideColumn" Width="0"/>        <!-- 二级侧栏：只有「日志」用得到 -->
                    <ColumnDefinition Width="*"/>                           <!-- 主区 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>                          <!-- 状态栏 -->
                </Grid.RowDefinitions>

                <!-- ============================================================
                     最左图标轨道（Codex 式）
                     ============================================================ -->
                <Border Grid.Column="0" Grid.RowSpan="2"
                        Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 导航 -->
                            <RowDefinition Height="*"/>      <!-- 弹性留白 -->
                            <RowDefinition Height="Auto"/>   <!-- 主题切换 -->
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10,0,0">
                            <RadioButton x:Name="NavOverview" GroupName="Rail" Style="{StaticResource RailNavButton}"
                                         Tag="overview" ToolTip="总览与控制" Click="Nav_Click">
                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconHome}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </RadioButton>
                            <!-- 网页区块以前用带浮出刷新的样式，现在刷新移到标题栏了，统一用普通样式 -->
                            <RadioButton x:Name="NavCoreWeb" GroupName="Rail" Style="{StaticResource RailNavButton}"
                                         Tag="coreweb" ToolTip="管理页面（Core 停止时仍可使用）" Click="Nav_Click">
                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconMonitor}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </RadioButton>
                            <StackPanel x:Name="ConnectionNav"/>
                            <RadioButton x:Name="NavConnections" GroupName="Rail" Style="{StaticResource RailNavButton}"
                                         Tag="connections" ToolTip="消息连接管理" Click="Nav_Click">
                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconChat}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </RadioButton>
                            <RadioButton x:Name="NavLogs" GroupName="Rail" Style="{StaticResource RailNavButton}"
                                         Tag="logs" ToolTip="日志" Click="Nav_Click">
                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconTerminal}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </RadioButton>
                            <Button Style="{StaticResource RailIconButton}" Content="＋" FontSize="24"
                                    ToolTip="添加接入器" Click="AddConnection_Click" AutomationProperties.Name="添加接入器"/>
                        </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" x:Name="ThemeToggle"
                                Style="{StaticResource RailIconButton}"
                                Margin="0,0,0,12"
                                ToolTip="切换深色 / 浅色"
                                Click="ThemeToggle_Click">
                            <Path x:Name="ThemeIcon" Width="20" Height="20"
                                  Stretch="Uniform"
                                  Data="{StaticResource IconSun}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ============================================================
                     二级侧栏：只有「总览」和「日志」需要它
                     页面区块会把这一列收成 0，把宽度全让给网页
                     ============================================================ -->
                <Border Grid.Column="1" Grid.Row="0"
                        Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <!-- —— 总览：不再有独立服务状态栏，状态并进主区的组件清单 —— -->

                        <!-- —— 日志：来源、筛选与操作 —— -->
                        <StackPanel x:Name="SideLogs" Margin="16,18,16,0" Visibility="Collapsed">
                            <TextBlock Text="日志" Style="{StaticResource TextSection}" Margin="0,0,0,12"/>

                            <RadioButton x:Name="LogTabCore" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="core" Content="Core" IsChecked="True" Click="LogTab_Click"/>
                            <RadioButton x:Name="LogTabSnowluma" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="snowluma" Content="SnowLuma" Click="LogTab_Click"/>
                            <RadioButton x:Name="LogTabIngress" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="ingress" Content="消息接入" Click="LogTab_Click"/>
                            <RadioButton x:Name="LogTabTunnel" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="tunnel" Content="Pi 隧道" Click="LogTab_Click"/>
                            <RadioButton x:Name="LogTabService" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="service" Content="管理服务" Click="LogTab_Click"/>

                            <CheckBox x:Name="LogAuto" Content="自动更新" IsChecked="True" Margin="2,14,0,8"/>
                            <CheckBox x:Name="LogFollow" Content="跟随最新" IsChecked="True" Margin="2,0,0,14"/>

                            <TextBlock Text="搜索" Style="{StaticResource TextLabel}" Margin="0,0,0,5"/>
                            <TextBox x:Name="LogSearch" ToolTip="筛选日志内容" TextChanged="LogSearch_Changed"/>

                            <Button Content="刷新" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,12,0,4" Click="LogRefresh_Click"/>
                            <Button Content="复制" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="LogCopy_Click"/>
                            <Button Content="打开日志目录" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,0" Click="LogFolder_Click"/>

                            <TextBlock x:Name="LogInfo" Style="{StaticResource TextLabel}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================================
                     主区
                     ============================================================ -->
                <Grid Grid.Column="2" Grid.Row="0">

                    <ScrollViewer x:Name="ConnectionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
                        <StackPanel x:Name="ConnectionsContent" MaxWidth="1000" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>

                    <!-- 总览 -->
                    <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
                        <StackPanel>
                            <TextBlock Text="总览与控制" Style="{StaticResource TextTitle}" Margin="0,0,0,12"/>

                            <!-- 版本卡：标题在左上，更新状态 chip 在最右上 -->
                            <local:ChamferBorder Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="版本" Style="{StaticResource TextSection}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" x:Name="VersionStatusChip" Style="{StaticResource StatusChip}">
                                            <TextBlock x:Name="VersionStatusText" Style="{StaticResource StatusChipText}" Text="已是最新"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="UpdateSummary" Text="组件独立更新，可选择历史版本并降级安装"
                                               Style="{StaticResource TextValue}" Margin="0,10,0,10"/>
                                    <WrapPanel>
                                        <Button Content="检查全部版本" Style="{StaticResource GhostButton}" Click="CheckAllUpdates_Click"/>
                                        <Button x:Name="RecoverUpdateButton" Content="恢复中断的安装" Style="{StaticResource GhostButton}"
                                                Visibility="Collapsed" Click="RecoverUpdate_Click"/>
                                        <CheckBox x:Name="AutoCheckUpdates" Content="自动检查更新"
                                                  Foreground="{DynamicResource BrushTextPrimary}"
                                                  VerticalAlignment="Center" Margin="6,0,0,0"
                                                  ToolTip="启动时及每 6 小时自动检查更新"
                                                  Click="AutoCheck_Changed"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="UpdateOperation" Text="" Style="{StaticResource TextValue}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </local:ChamferBorder>

                            <!-- 组件卡：每行「名称在上，版本与运行信息在下，操作在右」，
                                 点行尾箭头在该行下方就地展开版本选择与安装。 -->
                            <local:ChamferBorder Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="组件" Style="{StaticResource TextSection}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" x:Name="ComponentsChip" Style="{StaticResource StatusChip}">
                                            <TextBlock x:Name="ComponentsChipText" Style="{StaticResource StatusChipText}" Text="—"/>
                                        </Border>
                                    </Grid>
                                    <WrapPanel Margin="0,10,0,6">
                                        <Button Content="启动全部" Style="{StaticResource PrimaryButton}" Click="StartAll_Click"/>
                                        <Button Content="停止全部" Style="{StaticResource GhostButton}" Click="StopAll_Click"/>
                                    </WrapPanel>

                                    <TextBlock Text="业务组件" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>

                                    <!-- Abyss Core -->
                                    <Border Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <!-- 表头整行可点：点任意位置展开/收起下方的状态细线与更新源行。
                                                 右侧操作区的图标自己吃掉点击，不会误触发整行。 -->
                                            <Grid Background="Transparent" Cursor="Hand" Tag="core"
                                                  ToolTip="点击展开 / 收起更新源" MouseLeftButtonUp="UpdateRow_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="CoreDot" Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Abyss Core" Style="{StaticResource TextSection}"
                                                               ToolTip="大脑 + 网页"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock x:Name="CoreVersion" Style="{StaticResource VersionChip}"/>
                                                        <TextBlock x:Name="CoreDetail" Text="—"
                                                                   Style="{StaticResource TextValue}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- 右侧：版本选择 + 下载 + 启动 + 停止 + 折叠角标。
                                                     三个动作图标常驻，差别只在是否可点。 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right" MouseLeftButtonUp="RowActions_Click">
                                                    <local:VersionSelectorControl x:Name="CoreSelector" Margin="0,0,8,0"/>
                                                    <Button x:Name="CoreDownload" Tag="core" Style="{StaticResource RowIconButton}"
                                                            Click="ComponentDownload_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE896;"/>
                                                    </Button>
                                                    <Button x:Name="CoreStart" Tag="core" Style="{StaticResource RowIconButton}"
                                                            ToolTip="启动" Click="TargetStart_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE768;"/>
                                                    </Button>
                                                    <Button x:Name="CoreStop" Tag="core" Style="{StaticResource RowIconButton}"
                                                            ToolTip="停止" Click="TargetStop_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE71A;"/>
                                                    </Button>
                                                    <ToggleButton x:Name="CoreUpdateToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <local:ComponentUpdateControl x:Name="CoreUpdate" Component="core"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}"/>

                                    <!-- SnowLuma -->
                                    <Border Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="snowluma"
                                                  ToolTip="点击展开 / 收起更新源" MouseLeftButtonUp="UpdateRow_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="SnowDot" Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="SnowLuma" Style="{StaticResource TextSection}"
                                                               ToolTip="QQ 登录"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock x:Name="SnowVersion" Style="{StaticResource VersionChip}"/>
                                                        <TextBlock x:Name="SnowlumaDetail" Text="—"
                                                                   Style="{StaticResource TextValue}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right" MouseLeftButtonUp="RowActions_Click">
                                                    <local:VersionSelectorControl x:Name="SnowSelector" Margin="0,0,8,0"/>
                                                    <Button x:Name="SnowDownload" Tag="snowluma" Style="{StaticResource RowIconButton}"
                                                            Click="ComponentDownload_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE896;"/>
                                                    </Button>
                                                    <Button x:Name="SnowStart" Tag="snowluma" Style="{StaticResource RowIconButton}"
                                                            ToolTip="启动" Click="TargetStart_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE768;"/>
                                                    </Button>
                                                    <Button x:Name="SnowStop" Tag="snowluma" Style="{StaticResource RowIconButton}"
                                                            ToolTip="停止" Click="TargetStop_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE71A;"/>
                                                    </Button>
                                                    <ToggleButton x:Name="SnowUpdateToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <local:ComponentUpdateControl x:Name="SnowUpdate" Component="snowluma"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}"/>

                                    <TextBlock Text="常驻服务" Style="{StaticResource TextLabel}" Margin="0,16,0,4"
                                               ToolTip="随启动器自动拉起，无需手动启停"/>

                                    <!-- 消息接入 -->
                                    <Border Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="ingress"
                                                  ToolTip="点击展开 / 收起更新源" MouseLeftButtonUp="UpdateRow_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="IngressDot" Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="消息接入" Style="{StaticResource TextSection}"
                                                               ToolTip="Core 停止时继续收消息"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock x:Name="IngressVersion" Style="{StaticResource VersionChip}"/>
                                                        <TextBlock x:Name="IngressDetail" Text="—"
                                                                   Style="{StaticResource TextValue}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right" MouseLeftButtonUp="RowActions_Click">
                                                    <local:VersionSelectorControl x:Name="IngressSelector" Margin="0,0,8,0"/>
                                                    <Button x:Name="IngressDownload" Tag="ingress" Style="{StaticResource RowIconButton}"
                                                            Click="ComponentDownload_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE896;"/>
                                                    </Button>
                                                    <Button x:Name="IngressStart" Tag="ingress" Style="{StaticResource RowIconButton}"
                                                            ToolTip="启动" Click="TargetStart_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE768;"/>
                                                    </Button>
                                                    <Button x:Name="IngressStop" Tag="ingress" Style="{StaticResource RowIconButton}"
                                                            ToolTip="停止" Click="TargetStop_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE71A;"/>
                                                    </Button>
                                                    <ToggleButton x:Name="IngressUpdateToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <local:ComponentUpdateControl x:Name="IngressUpdate" Component="ingress"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}"/>

                                    <!-- Pi 隧道：本机到树莓派的 ssh 转发，断了微信就发不出去 -->
                                    <Border x:Name="TunnelRow" Style="{StaticResource ComponentRow}" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="TunnelDot" Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Pi 隧道" Style="{StaticResource TextSection}"
                                                               ToolTip="本机到树莓派的 ssh 转发；断开后微信收发会失效"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock x:Name="TunnelDetail" Text="—"
                                                                   Style="{StaticResource TextValue}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right" MouseLeftButtonUp="RowActions_Click">
                                                    <Button x:Name="TunnelStart" Tag="tunnel" Style="{StaticResource RowIconButton}"
                                                            ToolTip="建立隧道" Click="TargetStart_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE768;"/>
                                                    </Button>
                                                    <Button x:Name="TunnelStop" Tag="tunnel" Style="{StaticResource RowIconButton}"
                                                            ToolTip="断开隧道" Click="TargetStop_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE71A;"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="TunnelRowDivider" Height="1"
                                            Background="{DynamicResource BrushBorderSubtle}" Visibility="Collapsed"/>

                                    <!-- 管理服务：随启动器自启，不需要手动启停，只做版本更新 -->
                                    <Border Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="manager"
                                                  ToolTip="点击展开 / 收起更新源" MouseLeftButtonUp="UpdateRow_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="ManagerDot" Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="管理服务" Style="{StaticResource TextSection}"
                                                               ToolTip="随启动器自启，负责进程与版本管理"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock x:Name="ManagerVersion" Style="{StaticResource VersionChip}"/>
                                                        <TextBlock Text="随启动器自启，无需手动启停"
                                                                   Style="{StaticResource TextValue}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right" MouseLeftButtonUp="RowActions_Click">
                                                    <local:VersionSelectorControl x:Name="ManagerSelector" Margin="0,0,8,0"/>
                                                    <Button x:Name="ManagerDownload" Tag="manager" Style="{StaticResource RowIconButton}"
                                                            Click="ComponentDownload_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE896;"/>
                                                    </Button>
                                                    <Button x:Name="ManagerStart" IsEnabled="False" Style="{StaticResource RowIconButton}"
                                                            ToolTip="随启动器自启，无需手动启停">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE768;"/>
                                                    </Button>
                                                    <Button x:Name="ManagerStop" IsEnabled="False" Style="{StaticResource RowIconButton}"
                                                            ToolTip="随启动器自启，无需手动启停">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE71A;"/>
                                                    </Button>
                                                    <ToggleButton x:Name="ManagerUpdateToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <local:ComponentUpdateControl x:Name="ManagerUpdate" Component="manager"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}"/>

                                    <!-- 桌面启动器：本程序自身，只做版本更新 -->
                                    <Border Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="launcher"
                                                  ToolTip="点击展开 / 收起更新源" MouseLeftButtonUp="UpdateRow_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="桌面启动器" Style="{StaticResource TextSection}"
                                                               ToolTip="本程序自身"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock x:Name="LauncherVersion" Style="{StaticResource VersionChip}"/>
                                                        <TextBlock Text="更新后需要重启启动器生效"
                                                                   Style="{StaticResource TextValue}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right" MouseLeftButtonUp="RowActions_Click">
                                                    <local:VersionSelectorControl x:Name="LauncherSelector" Margin="0,0,8,0"/>
                                                    <Button x:Name="LauncherDownload" Tag="launcher" Style="{StaticResource RowIconButton}"
                                                            Click="ComponentDownload_Click">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE896;"/>
                                                    </Button>
                                                    <Button x:Name="LauncherStart" IsEnabled="False" Style="{StaticResource RowIconButton}"
                                                            ToolTip="本程序自身，无需手动启停">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE768;"/>
                                                    </Button>
                                                    <Button x:Name="LauncherStop" IsEnabled="False" Style="{StaticResource RowIconButton}"
                                                            ToolTip="本程序自身，无需手动启停">
                                                        <TextBlock Style="{StaticResource RowGlyph}" Text="&#xE71A;"/>
                                                    </Button>
                                                    <ToggleButton x:Name="LauncherUpdateToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <local:ComponentUpdateControl x:Name="LauncherUpdate" Component="launcher"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </local:ChamferBorder>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 网页占满整个主区：页面名与状态移到底部状态栏，
                         刷新按钮浮在左侧轨道上（悬停导航项才出现），
                         所以这里不再有横栏。控制栏仍在网页外部（任务书 §7）。 -->
                    <Grid x:Name="WebPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Pi 隧道状态条：VNC 画面直连 Pi，不代表隧道通；
                             这一条单独显示隧道/桥接状态，断线时可在这里一键重连。 -->
                        <Border x:Name="TunnelBar" Grid.Row="0" Visibility="Collapsed"
                                Background="{DynamicResource BrushBgRaised}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="0,0,0,1" Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="TunnelBarDot" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                <TextBlock x:Name="TunnelBarText" Grid.Column="1" Margin="10,0,12,0"
                                           Style="{StaticResource TextValue}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button x:Name="TunnelBarAction" Grid.Column="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="连接 Pi" Click="TunnelBarAction_Click"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
                            <Border x:Name="WebUnavailable" Background="{DynamicResource BrushBgSunken}" Padding="32">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                                    <TextBlock x:Name="WebUnavailableTitle" Text="等待连接"
                                               Style="{StaticResource TextTitle}"
                                               FontSize="{DynamicResource FontSize2xl}"
                                               TextAlignment="Center"/>
                                    <TextBlock x:Name="WebUnavailableDetail"
                                               Style="{StaticResource TextValue}"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               TextWrapping="Wrap" Margin="0,12,0,20" TextAlignment="Center"/>
                                    <Button x:Name="WebStartButton" Content="启动程序"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="20,8" HorizontalAlignment="Center"
                                            Visibility="Collapsed" Click="WebStart_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 日志正文 -->
                    <Grid x:Name="LogsPanel" Visibility="Collapsed">
                        <RichTextBox x:Name="LogBox"
                                     Background="{DynamicResource BrushBgSunken}"
                                     Foreground="{DynamicResource BrushTextSecondary}"
                                     FontFamily="{DynamicResource FontMono}"
                                     FontSize="{DynamicResource FontSizeSm}"
                                     IsReadOnly="True" IsDocumentEnabled="False"
                                     BorderThickness="0"
                                     Padding="14,12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                    </Grid>

                </Grid>

                <!-- ============================================================
                     状态栏
                     ============================================================ -->
                <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                        Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="16,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 网页区块的页面名与运行状态放在状态栏里：不额外占竖向空间 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="WebPageTitle" Text=""
                                       FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock x:Name="WebPageState" Text="" Margin="8,0,0,0"
                                       FontSize="{DynamicResource FontSizeSm}"
                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="StatusBar" Text="就绪"
                                   HorizontalAlignment="Right"
                                   FontSize="{DynamicResource FontSizeSm}"
                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
