<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AbyssLauncher</AssemblyName>
    <RootNamespace>AbyssLauncher</RootNamespace>
    <AssemblyTitle>Abyss 桌面启动管理器</AssemblyTitle>
    <Version>0.3.0</Version>
    <!-- 验证版锁定构建配置 -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <!-- UseWindowsForms 会隐式引入 System.Windows.Forms 全局 using，
       与 WPF 的 Application/MessageBox 产生二义性；托盘代码全部用全限定名 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
