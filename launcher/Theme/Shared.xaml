<!-- 形态与字体令牌（端无关，主题切换时不重建） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- 圆角 -->
  <CornerRadius x:Key="RadiusNone">0</CornerRadius>
  <CornerRadius x:Key="RadiusXs">2</CornerRadius>
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">10</CornerRadius>
  <CornerRadius x:Key="RadiusXl">14</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>

  <!-- 斜切角 -->
  <sys:Double x:Key="ChamferSm">4</sys:Double>
  <sys:Double x:Key="ChamferMd">8</sys:Double>
  <sys:Double x:Key="ChamferLg">14</sys:Double>

  <!-- 描边 -->
  <Thickness x:Key="BorderHair">1</Thickness>
  <Thickness x:Key="BorderThick">2</Thickness>

  <!-- 间距 -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <Thickness x:Key="Pad1">4</Thickness>
  <sys:Double x:Key="Space2">8</sys:Double>
  <Thickness x:Key="Pad2">8</Thickness>
  <sys:Double x:Key="Space3">12</sys:Double>
  <Thickness x:Key="Pad3">12</Thickness>
  <sys:Double x:Key="Space4">16</sys:Double>
  <Thickness x:Key="Pad4">16</Thickness>
  <sys:Double x:Key="Space5">20</sys:Double>
  <Thickness x:Key="Pad5">20</Thickness>
  <sys:Double x:Key="Space6">24</sys:Double>
  <Thickness x:Key="Pad6">24</Thickness>
  <sys:Double x:Key="Space7">32</sys:Double>
  <Thickness x:Key="Pad7">32</Thickness>

  <!-- 字体 -->
  <FontFamily x:Key="FontSans">Inter, BlinkMacSystemFont, Segoe UI, PingFang SC, Hiragino Sans GB, Microsoft YaHei, sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">JetBrains Mono, Fira Code, Cascadia Code, Consolas, monospace</FontFamily>
  <sys:Double x:Key="FontSizeXs">11</sys:Double>
  <sys:Double x:Key="FontSizeSm">12</sys:Double>
  <sys:Double x:Key="FontSizeMd">13</sys:Double>
  <sys:Double x:Key="FontSizeBase">14</sys:Double>
  <sys:Double x:Key="FontSizeLg">15</sys:Double>
  <sys:Double x:Key="FontSizeXl">18</sys:Double>
  <sys:Double x:Key="FontSize2xl">22</sys:Double>
  <sys:Double x:Key="FontWeightRegular">400</sys:Double>
  <sys:Double x:Key="FontWeightMedium">500</sys:Double>
  <sys:Double x:Key="FontWeightSemibold">600</sys:Double>
  <sys:Double x:Key="FontWeightBold">700</sys:Double>

</ResourceDictionary>
