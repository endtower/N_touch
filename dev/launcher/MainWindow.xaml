<Window x:Class="AbyssLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AbyssLauncher"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="弱链接" Height="760" Width="1180" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource FontSans}"
        FontSize="{DynamicResource FontSizeBase}"
        Background="{DynamicResource BrushBgApp}"
        Closing="Window_Closing">

    <!-- 自绘标题栏（Codex 式）：去掉系统标题栏，− □ × 内嵌进应用自己的一条栏。
         CaptionHeight=40 让这条栏自动具备拖动与双击最大化；栏内需要接收点击的
         控件必须标 WindowChrome.IsHitTestVisibleInChrome="True"。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 窗口按钮图标：描边式，和轨道图标同一套画法 -->
        <StreamGeometry x:Key="GlyphMinimize">M0,6 H12</StreamGeometry>
        <StreamGeometry x:Key="GlyphMaximize">M0.5,0.5 H11.5 V11.5 H0.5 Z</StreamGeometry>
        <StreamGeometry x:Key="GlyphRestore">M3.5,0.5 H11.5 V8.5 M0.5,3.5 H8.5 V11.5 H0.5 Z</StreamGeometry>
        <StreamGeometry x:Key="GlyphClose">M0.5,0.5 L11.5,11.5 M11.5,0.5 L0.5,11.5</StreamGeometry>
        <!-- 设置：两条带旋钮的滑杆 -->
        <StreamGeometry x:Key="GlyphSliders">M3,8 H21 M3,16 H21 M9,6 A2,2 0 1 1 8.99,6 Z M15,14 A2,2 0 1 1 14.99,14 Z</StreamGeometry>
    </Window.Resources>

    <!-- 1px 外框：WindowStyle=None 之后没有系统边框，靠这层定义窗口边缘 -->
    <Border BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- 自绘标题栏 -->
                <RowDefinition Height="*"/>    <!-- 主体（含它自己的状态栏行） -->
            </Grid.RowDefinitions>

            <!-- ============================================================
                 标题栏
                 ============================================================ -->
            <Grid Grid.Row="0" Background="{DynamicResource BrushBgSurface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                    <local:ChamferBorder Width="18" Height="18" Chamfer="5" Corners="Diagonal"
                                         Background="{DynamicResource BrushAccent}"
                                         VerticalAlignment="Center">
                        <TextBlock Text="A" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextOnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </local:ChamferBorder>
                    <TextBlock Text="弱链接" Margin="9,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <!-- 构建时间戳水印：存在多份同名 EXE 时，据此辨认当前运行的是哪一次构建 -->
                    <TextBlock x:Name="BuildStampText" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSm}"
                               Foreground="{DynamicResource BrushTextTertiary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 刷新当前网页。放在标题栏里，永远可见 ——
                         比"悬停浮出"那套稳得多：不涉及 Popup、不涉及 WebView2 的层级问题。 -->
                    <Button x:Name="BtnRefreshWeb" Style="{StaticResource WindowButton}"
                            Margin="0,0,4,0"
                            ToolTip="刷新当前网页" Click="RefreshWeb_Click">
                        <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource IconRefresh}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>

                    <Button x:Name="BtnSettings" Style="{StaticResource WindowButton}"
                            Margin="0,0,4,0"
                            ToolTip="设置" Click="Settings_Click">
                        <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource GlyphSliders}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>

                    <Border Width="1" Height="18" Margin="2,0,4,0"
                            Background="{DynamicResource BrushBorderSubtle}"/>

                    <Button x:Name="BtnMinimize" Style="{StaticResource WindowButton}"
                            ToolTip="最小化" Click="Minimize_Click">
                        <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource GlyphMinimize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Style="{StaticResource WindowButton}"
                            ToolTip="最大化" Click="MaximizeRestore_Click">
                        <Path x:Name="MaximizeGlyph" Width="12" Height="12" Stretch="Uniform"
                              Data="{StaticResource GlyphMaximize}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}"
                            ToolTip="关闭（隐藏到托盘，后台继续运行）" Click="Close_Click">
                        <Path Width="12" Height="12" Stretch="Uniform" Data="{StaticResource GlyphClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>

                <!-- 设置面板。StaysOpen=False：点面板外面自动收起，不需要任何自己写的开合逻辑。 -->
                <Popup x:Name="SettingsPopup"
                       PlacementTarget="{Binding ElementName=BtnSettings}"
                       Placement="Bottom"
                       HorizontalOffset="-186"
                       VerticalOffset="2"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource BrushBgRaised}"
                            BorderBrush="{DynamicResource BrushBorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusLg}"
                            Padding="14,12"
                            Margin="8">
                        <StackPanel Width="228">
                            <TextBlock Text="点标题栏 × 时" FontWeight="SemiBold"
                                       FontSize="{DynamicResource FontSizeMd}"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       Margin="0,0,0,10"/>
                            <RadioButton x:Name="SetCloseToTray" GroupName="CloseBehavior"
                                         Style="{StaticResource SegmentedTab}"
                                         Content="隐藏到托盘（后台继续运行）"
                                         Checked="CloseBehavior_Changed"/>
                            <RadioButton x:Name="SetCloseExit" GroupName="CloseBehavior"
                                         Style="{StaticResource SegmentedTab}"
                                         Content="退出程序（停止 Core 与 SnowLuma）"
                                         Checked="CloseBehavior_Changed"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- ============================================================
                 主体
                 ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>                        <!-- 最左图标轨道 -->
                    <ColumnDefinition x:Name="SideColumn" Width="0"/>        <!-- 二级侧栏：只有「日志」用得到 -->
                    <ColumnDefinition Width="*"/>                           <!-- 主区 -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>                          <!-- 状态栏 -->
                </Grid.RowDefinitions>

                <!-- ============================================================
                     最左图标轨道（Codex 式）
                     ============================================================ -->
                <Border Grid.Column="0" Grid.RowSpan="2"
                        Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- 导航 -->
                            <RowDefinition Height="*"/>      <!-- 弹性留白 -->
                            <RowDefinition Height="Auto"/>   <!-- 主题切换 -->
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10,0,0">
                            <RadioButton x:Name="NavOverview" GroupName="Rail" Style="{StaticResource RailNavButton}"
                                         Tag="overview" ToolTip="总览与控制" Click="Nav_Click">
                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconHome}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </RadioButton>
                            <!-- 网页区块以前用带浮出刷新的样式，现在刷新移到标题栏了，统一用普通样式 -->
                            <RadioButton x:Name="NavCoreWeb" GroupName="Rail" Style="{StaticResource RailNavButton}"
                                         Tag="coreweb" ToolTip="管理页面（Core 停止时仍可使用）" Click="Nav_Click">
                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconMonitor}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </RadioButton>
                            <StackPanel x:Name="ConnectionNav"/>
                            <RadioButton x:Name="NavConnections" GroupName="Rail" Style="{StaticResource RailNavButton}"
                                         Tag="connections" ToolTip="消息连接管理" Click="Nav_Click">
                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconChat}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </RadioButton>
                            <RadioButton x:Name="NavLogs" GroupName="Rail" Style="{StaticResource RailNavButton}"
                                         Tag="logs" ToolTip="日志" Click="Nav_Click">
                                <Path Width="20" Height="20" Stretch="Uniform" Data="{StaticResource IconTerminal}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </RadioButton>
                            <Button Style="{StaticResource RailIconButton}" Content="＋" FontSize="24"
                                    ToolTip="添加接入器" Click="AddConnection_Click" AutomationProperties.Name="添加接入器"/>
                        </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" x:Name="ThemeToggle"
                                Style="{StaticResource RailIconButton}"
                                Margin="0,0,0,12"
                                ToolTip="切换深色 / 浅色"
                                Click="ThemeToggle_Click">
                            <Path x:Name="ThemeIcon" Width="20" Height="20"
                                  Stretch="Uniform"
                                  Data="{StaticResource IconSun}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ============================================================
                     二级侧栏：只有「总览」和「日志」需要它
                     页面区块会把这一列收成 0，把宽度全让给网页
                     ============================================================ -->
                <Border Grid.Column="1" Grid.Row="0"
                        Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <!-- —— 总览：不再有独立服务状态栏，状态并进主区的组件清单 —— -->

                        <!-- —— 日志：来源、筛选与操作 —— -->
                        <StackPanel x:Name="SideLogs" Margin="16,18,16,0" Visibility="Collapsed">
                            <TextBlock Text="日志" Style="{StaticResource TextSection}" Margin="0,0,0,12"/>

                            <RadioButton x:Name="LogTabCore" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="core" Content="Core" IsChecked="True" Click="LogTab_Click"/>
                            <RadioButton x:Name="LogTabSnowluma" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="snowluma" Content="SnowLuma" Click="LogTab_Click"/>
                            <RadioButton x:Name="LogTabIngress" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="ingress" Content="消息接入" Click="LogTab_Click"/>
                            <RadioButton x:Name="LogTabTunnel" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="tunnel" Content="Pi 隧道" Click="LogTab_Click"/>
                            <RadioButton x:Name="LogTabService" GroupName="LogSource" Style="{StaticResource SegmentedTab}"
                                         Tag="service" Content="管理服务" Click="LogTab_Click"/>

                            <CheckBox x:Name="LogAuto" Content="自动更新" IsChecked="True" Margin="2,14,0,8"/>
                            <CheckBox x:Name="LogFollow" Content="跟随最新" IsChecked="True" Margin="2,0,0,14"/>

                            <TextBlock Text="搜索" Style="{StaticResource TextLabel}" Margin="0,0,0,5"/>
                            <TextBox x:Name="LogSearch" ToolTip="筛选日志内容" TextChanged="LogSearch_Changed"/>

                            <Button Content="刷新" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,12,0,4" Click="LogRefresh_Click"/>
                            <Button Content="复制" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="LogCopy_Click"/>
                            <Button Content="打开日志目录" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,0" Click="LogFolder_Click"/>

                            <TextBlock x:Name="LogInfo" Style="{StaticResource TextLabel}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================================
                     主区
                     ============================================================ -->
                <Grid Grid.Column="2" Grid.Row="0">

                    <ScrollViewer x:Name="ConnectionsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
                        <StackPanel x:Name="ConnectionsContent" MaxWidth="1000" HorizontalAlignment="Stretch"/>
                    </ScrollViewer>

                    <!-- 总览 -->
                    <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto" Padding="24,18,24,22">
                        <StackPanel x:Name="OverviewContent" MaxWidth="1040" HorizontalAlignment="Stretch">

                            <!-- 页头：一句话说清现在是什么状态、下一步该点什么 -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="总览" Style="{StaticResource TextTitle}"/>
                                    <TextBlock x:Name="OverviewHeadline" Style="{StaticResource TextValue}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="正在读取运行状态…"/>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="OverviewChip" Style="{StaticResource StatusChip}"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="OverviewChipText" Style="{StaticResource StatusChipText}" Text="—"/>
                                </Border>
                            </Grid>

                            <!-- 主控：一键启动 / 暂停 / 停止全部；右边是版本检查入口 -->
                            <local:ChamferBorder Style="{StaticResource Card}" Padding="16,13">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel>
                                            <Button x:Name="StartAllButton" Content="一键启动" Style="{StaticResource PrimaryButton}"
                                                    Click="StartAll_Click" ToolTip="按顺序启动勾选的链路；失败的那条可以单独继续或跳过"/>
                                            <Button Content="暂停" Style="{StaticResource GhostButton}" Click="StartupPause_Click"
                                                    ToolTip="暂停后续步骤；已经运行的程序保持现状"/>
                                            <Button Content="停止全部" Style="{StaticResource GhostButton}" Click="StopAll_Click"
                                                    ToolTip="停止 Core、SnowLuma 与消息接入"/>
                                        </WrapPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="AutoCheckUpdates" Content="自动检查更新" VerticalAlignment="Center"
                                                      Margin="0,0,12,0" Click="AutoCheck_Changed"
                                                      ToolTip="启动时与每 6 小时检查一次；只检查，不自动下载或安装"/>
                                            <Button Content="检查更新" Style="{StaticResource GhostButton}" Click="CheckAllUpdates_Click"
                                                    ToolTip="获取各组件当前可选的版本"/>
                                        </StackPanel>
                                    </Grid>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button x:Name="RecoverUpdateButton" DockPanel.Dock="Right" Content="恢复中断的安装"
                                                Style="{StaticResource GhostButton}" Visibility="Collapsed" Click="RecoverUpdate_Click"/>
                                        <TextBlock x:Name="StartupSummary" Style="{StaticResource TextLabel}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Text="尚未启动"/>
                                    </DockPanel>
                                </StackPanel>
                            </local:ChamferBorder>

                            <!-- 程序清单：一行一件事；行右侧是这件事唯一的操作入口 -->
                            <Grid Margin="6,6,6,8">
                                <TextBlock Text="程序" Style="{StaticResource TextLabel}"/>
                                <TextBlock Text="点行展开详情、版本与更新" HorizontalAlignment="Right" Style="{StaticResource TextLabel}"/>
                            </Grid>

                            <local:ChamferBorder Style="{StaticResource Card}" Padding="6,4">
                                <StackPanel>

                                    <!-- ================= Abyss Core ================= -->
                                    <Border x:Name="CoreRow" Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="core" MouseLeftButtonUp="RowHeader_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="CoreDot" Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="CoreRowTitle" Text="弱链接 Core" Style="{StaticResource TextSection}"/>
                                                        <TextBlock x:Name="CoreVersion" Style="{StaticResource VersionChip}" Margin="9,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="CoreDetail" Style="{StaticResource RowMeta}" Text="—" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" x:Name="CorePill" Style="{StaticResource StatusChip}" Margin="0,0,10,0">
                                                    <TextBlock x:Name="CoreState" Style="{StaticResource StatusChipText}" Text="未启动"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                            MouseLeftButtonUp="RowActions_Click">
                                                    <Button x:Name="CoreAction" Tag="core" Content="启动" MinWidth="60"
                                                            Style="{StaticResource GhostButton}" Click="ChainRowAction_Click"/>
                                                    <ToggleButton x:Name="CoreToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="CorePanel" Visibility="Collapsed" Margin="20,6,4,10">
                                                <TextBlock Text="启动顺序" Style="{StaticResource TextLabel}" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="CoreSteps" Style="{StaticResource RowMeta}" Text="—"/>
                                                <TextBlock x:Name="CoreMessage" Style="{StaticResource TextLabel}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <CheckBox x:Name="CoreParticipate" Content="参与一键启动" Tag="core"
                                                              Margin="0,0,8,0" Click="StartupEnable_Click"/>
                                                    <Button x:Name="CoreContinue" Tag="core" Content="继续" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="StartupContinue_Click"
                                                            ToolTip="立即复查一次当前步骤"/>
                                                    <Button x:Name="CoreSkip" Tag="core" Content="跳过" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="StartupSkip_Click"
                                                            ToolTip="本轮跳过这条链路，不影响其它程序"/>
                                                    <Button x:Name="CoreStopButton" Tag="core" Content="停止此程序" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="TargetStop_Click"/>
                                                </WrapPanel>
                                                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,12,0,10"/>
                                                <local:ComponentUpdateControl x:Name="CoreUpdate" Component="core"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SnowDivider" Height="1" Margin="6,0" Background="{DynamicResource BrushBorderSubtle}"/>

                                    <!-- ================= SnowLuma · QQ ================= -->
                                    <Border x:Name="SnowRow" Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="snowluma" MouseLeftButtonUp="RowHeader_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="SnowDot" Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="SnowRowTitle" Text="SnowLuma · QQ" Style="{StaticResource TextSection}"/>
                                                        <TextBlock x:Name="SnowVersion" Style="{StaticResource VersionChip}" Margin="9,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="SnowDetail" Style="{StaticResource RowMeta}" Text="—" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" x:Name="SnowPill" Style="{StaticResource StatusChip}" Margin="0,0,10,0">
                                                    <TextBlock x:Name="SnowState" Style="{StaticResource StatusChipText}" Text="未启动"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                            MouseLeftButtonUp="RowActions_Click">
                                                    <Button x:Name="SnowAction" Tag="snowluma" Content="启动" MinWidth="60"
                                                            Style="{StaticResource GhostButton}" Click="ChainRowAction_Click"/>
                                                    <ToggleButton x:Name="SnowToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="SnowPanel" Visibility="Collapsed" Margin="20,6,4,10">
                                                <TextBlock Text="启动顺序" Style="{StaticResource TextLabel}" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="SnowSteps" Style="{StaticResource RowMeta}" Text="—"/>
                                                <TextBlock x:Name="SnowMessage" Style="{StaticResource TextLabel}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <CheckBox x:Name="SnowParticipate" Content="参与一键启动" Tag="snowluma"
                                                              Margin="0,0,8,0" Click="StartupEnable_Click"/>
                                                    <Button x:Name="SnowContinue" Tag="snowluma" Content="继续" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="StartupContinue_Click"
                                                            ToolTip="立即复查一次当前步骤"/>
                                                    <Button x:Name="SnowSkip" Tag="snowluma" Content="跳过" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="StartupSkip_Click"/>
                                                    <Button x:Name="SnowStopButton" Tag="snowluma" Content="停止此程序" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="TargetStop_Click"/>
                                                </WrapPanel>
                                                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,12,0,10"/>
                                                <local:ComponentUpdateControl x:Name="SnowUpdate" Component="snowluma"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PiDivider" Height="1" Margin="6,0" Background="{DynamicResource BrushBorderSubtle}"/>

                                    <!-- ================= Pi · 个人桥接 ================= -->
                                    <Border x:Name="PiRow" Style="{StaticResource ComponentRow}" Visibility="Collapsed">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="pi" MouseLeftButtonUp="RowHeader_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="PiDot" Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PiRowTitle" Text="Pi · 个人桥接" Style="{StaticResource TextSection}"/>
                                                    <TextBlock x:Name="PiDetail" Style="{StaticResource RowMeta}" Text="—" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" x:Name="PiPill" Style="{StaticResource StatusChip}" Margin="0,0,10,0">
                                                    <TextBlock x:Name="PiState" Style="{StaticResource StatusChipText}" Text="未启用"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                            MouseLeftButtonUp="RowActions_Click">
                                                    <Button x:Name="PiAction" Tag="pi" Content="启动" MinWidth="60"
                                                            Style="{StaticResource GhostButton}" Click="ChainRowAction_Click"/>
                                                    <ToggleButton x:Name="PiToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="PiPanel" Visibility="Collapsed" Margin="20,6,4,10">
                                                <TextBlock Text="启动顺序" Style="{StaticResource TextLabel}" Margin="0,0,0,5"/>
                                                <TextBlock x:Name="PiSteps" Style="{StaticResource RowMeta}" Text="—"/>
                                                <TextBlock x:Name="PiMessage" Style="{StaticResource TextLabel}"
                                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <WrapPanel Margin="0,10,0,0">
                                                    <CheckBox x:Name="PiParticipate" Content="参与一键启动" Tag="pi"
                                                              Margin="0,0,8,0" Click="StartupEnable_Click"/>
                                                    <Button x:Name="PiContinue" Tag="pi" Content="继续" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="StartupContinue_Click"
                                                            ToolTip="立即复查一次当前步骤"/>
                                                    <Button x:Name="PiSkip" Tag="pi" Content="跳过" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="StartupSkip_Click"/>
                                                    <Button x:Name="PiStopButton" Tag="tunnel" Content="停止此程序" Visibility="Collapsed"
                                                            Style="{StaticResource GhostButton}" Click="TargetStop_Click"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ================= 常驻服务 ================= -->
                                    <Border x:Name="ServiceDivider" Height="1" Margin="6,0" Background="{DynamicResource BrushBorderSubtle}"/>
                                    <TextBlock x:Name="ServiceHeader" Text="常驻服务 · 随启动器自动运行" Style="{StaticResource TextLabel}"
                                               Margin="6,10,6,4"/>

                                    <!-- 消息接入 -->
                                    <Border x:Name="IngressRow" Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="ingress" MouseLeftButtonUp="RowHeader_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="IngressDot" Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="IngressRowTitle" Text="消息接入" Style="{StaticResource TextSection}"/>
                                                        <TextBlock x:Name="IngressVersion" Style="{StaticResource VersionChip}" Margin="9,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="IngressDetail" Style="{StaticResource RowMeta}" Text="—" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" x:Name="IngressPill" Style="{StaticResource StatusChip}" Margin="0,0,10,0">
                                                    <TextBlock x:Name="IngressState" Style="{StaticResource StatusChipText}" Text="未启动"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                            MouseLeftButtonUp="RowActions_Click">
                                                    <Button x:Name="IngressAction" Tag="ingress" Content="启动" MinWidth="60"
                                                            Style="{StaticResource GhostButton}" Click="IngressAction_Click"/>
                                                    <ToggleButton x:Name="IngressToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="IngressPanel" Visibility="Collapsed" Margin="20,6,4,10">
                                                <TextBlock Style="{StaticResource TextLabel}" TextWrapping="Wrap"
                                                           Text="常驻服务：负责 QQ 消息收发，Core 停止时也会继续收消息。启动器打开后会自动拉起。"/>
                                                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,12,0,10"/>
                                                <local:ComponentUpdateControl x:Name="IngressUpdate" Component="ingress"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="ManagerDivider" Height="1" Margin="6,0" Background="{DynamicResource BrushBorderSubtle}"/>

                                    <!-- 管理服务 -->
                                    <Border x:Name="ManagerRow" Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="manager" MouseLeftButtonUp="RowHeader_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="ManagerDot" Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="ManagerRowTitle" Text="管理服务" Style="{StaticResource TextSection}"/>
                                                        <TextBlock x:Name="ManagerVersion" Style="{StaticResource VersionChip}" Margin="9,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ManagerDetail" Style="{StaticResource RowMeta}"
                                                               Text="随启动器自启，负责进程与版本管理" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" x:Name="ManagerPill" Style="{StaticResource StatusChip}" Margin="0,0,10,0">
                                                    <TextBlock x:Name="ManagerState" Style="{StaticResource StatusChipText}" Text="运行中"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                            MouseLeftButtonUp="RowActions_Click">
                                                    <ToggleButton x:Name="ManagerToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="ManagerPanel" Visibility="Collapsed" Margin="20,6,4,10">
                                                <TextBlock Style="{StaticResource TextLabel}" TextWrapping="Wrap"
                                                           Text="随启动器自启，负责进程管理与组件安装；更新它会短暂重启后台服务，之后恢复原有运行状态。"/>
                                                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,12,0,10"/>
                                                <local:ComponentUpdateControl x:Name="ManagerUpdate" Component="manager"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="LauncherDivider" Height="1" Margin="6,0" Background="{DynamicResource BrushBorderSubtle}"/>

                                    <!-- 桌面启动器：本程序自身，只做版本更新 -->
                                    <Border x:Name="LauncherRow" Style="{StaticResource ComponentRow}">
                                        <StackPanel>
                                            <Grid Background="Transparent" Cursor="Hand" Tag="launcher" MouseLeftButtonUp="RowHeader_Click">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="LauncherDot" Width="9" Height="9" VerticalAlignment="Center"
                                                         Fill="{DynamicResource BrushTagSuccess}"/>
                                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="LauncherRowTitle" Text="桌面启动器" Style="{StaticResource TextSection}"/>
                                                        <TextBlock x:Name="LauncherVersion" Style="{StaticResource VersionChip}" Margin="9,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LauncherDetail" Style="{StaticResource RowMeta}"
                                                               Text="就是当前这个窗口；更新后需要重启启动器生效" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" x:Name="LauncherPill" Style="{StaticResource StatusChip}" Margin="0,0,10,0">
                                                    <TextBlock x:Name="LauncherState" Style="{StaticResource StatusChipText}" Text="运行中"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                            MouseLeftButtonUp="RowActions_Click">
                                                    <ToggleButton x:Name="LauncherToggle" Style="{StaticResource ChevronToggle}"
                                                                  IsHitTestVisible="False" Margin="2,0,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="LauncherPanel" Visibility="Collapsed" Margin="20,6,4,10">
                                                <TextBlock Style="{StaticResource TextLabel}" TextWrapping="Wrap"
                                                           Text="本程序自身。更新会关闭并重开窗口，后台服务继续运行。"/>
                                                <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,12,0,10"/>
                                                <local:ComponentUpdateControl x:Name="LauncherUpdate" Component="launcher"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </local:ChamferBorder>

                            <!-- 页脚：更新检查结果与操作回执 -->
                            <Grid Margin="6,10,6,0">
                                <TextBlock x:Name="UpdateSummary" Style="{StaticResource TextLabel}"
                                           Text="组件独立更新，可选择历史版本并降级安装"/>
                                <TextBlock x:Name="UpdateOperation" Style="{StaticResource TextLabel}"
                                           HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"
                                           MaxWidth="560"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- 网页占满整个主区：页面名与状态移到底部状态栏，
                         刷新按钮浮在左侧轨道上（悬停导航项才出现），
                         所以这里不再有横栏。控制栏仍在网页外部（任务书 §7）。 -->
                    <Grid x:Name="WebPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Pi 隧道状态条：VNC 画面直连 Pi，不代表隧道通；
                             这一条单独显示隧道/桥接状态，断线时可在这里一键重连。 -->
                        <Border x:Name="TunnelBar" Grid.Row="0" Visibility="Collapsed"
                                Background="{DynamicResource BrushBgRaised}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="0,0,0,1" Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="TunnelBarDot" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{DynamicResource BrushTextDisabled}"/>
                                <TextBlock x:Name="TunnelBarText" Grid.Column="1" Margin="10,0,12,0"
                                           Style="{StaticResource TextValue}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button x:Name="TunnelBarAction" Grid.Column="2"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="连接 Pi" Click="TunnelBarAction_Click"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
                            <Border x:Name="WebUnavailable" Background="{DynamicResource BrushBgSunken}" Padding="32">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                                    <TextBlock x:Name="WebUnavailableTitle" Text="等待连接"
                                               Style="{StaticResource TextTitle}"
                                               FontSize="{DynamicResource FontSize2xl}"
                                               TextAlignment="Center"/>
                                    <TextBlock x:Name="WebUnavailableDetail"
                                               Style="{StaticResource TextValue}"
                                               Foreground="{DynamicResource BrushTextTertiary}"
                                               TextWrapping="Wrap" Margin="0,12,0,20" TextAlignment="Center"/>
                                    <Button x:Name="WebStartButton" Content="启动程序"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="20,8" HorizontalAlignment="Center"
                                            Visibility="Collapsed" Click="WebStart_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 日志正文 -->
                    <Grid x:Name="LogsPanel" Visibility="Collapsed">
                        <RichTextBox x:Name="LogBox"
                                     Background="{DynamicResource BrushBgSunken}"
                                     Foreground="{DynamicResource BrushTextSecondary}"
                                     FontFamily="{DynamicResource FontMono}"
                                     FontSize="{DynamicResource FontSizeSm}"
                                     IsReadOnly="True" IsDocumentEnabled="False"
                                     BorderThickness="0"
                                     Padding="14,12"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"/>
                    </Grid>

                </Grid>

                <!-- ============================================================
                     状态栏
                     ============================================================ -->
                <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                        Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="16,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 网页区块的页面名与运行状态放在状态栏里：不额外占竖向空间 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="WebPageTitle" Text=""
                                       FontSize="{DynamicResource FontSizeSm}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock x:Name="WebPageState" Text="" Margin="8,0,0,0"
                                       FontSize="{DynamicResource FontSizeSm}"
                                       Foreground="{DynamicResource BrushTextTertiary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="StatusBar" Text="就绪"
                                   HorizontalAlignment="Right"
                                   FontSize="{DynamicResource FontSizeSm}"
                                   Foreground="{DynamicResource BrushTextTertiary}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
