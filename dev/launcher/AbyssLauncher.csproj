<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AbyssLauncher</AssemblyName>
    <RootNamespace>AbyssLauncher</RootNamespace>
    <AssemblyTitle>弱链接</AssemblyTitle>
    <Version>0.9.0</Version>
    <!-- 构建时间戳水印：写入程序集元数据，启动器标题栏读取并显示。
         存在多份同名 EXE 时可据此辨认当前运行的是哪一次构建（2026-10-15）。 -->
    <BuildStamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</BuildStamp>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <!-- 验证版锁定构建配置 -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <Compile Include="../updater/Installer.cs" Link="Updates/Installer.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildStamp" Value="$(BuildStamp)" />
  </ItemGroup>
  <ItemGroup Condition="'$(BootstrapBundle)' != ''">
    <EmbeddedResource Include="$(BootstrapBundle)" LogicalName="Abyss.Bootstrap.zip" />
  </ItemGroup>

  <!-- UseWindowsForms 会隐式引入 System.Windows.Forms / System.Drawing 全局 using，
       与 WPF 的 Application/MessageBox/Brush/Size 等类型产生二义性（CS0104）；
       托盘与图标代码全部用全限定名，所以这里直接摘掉这两个隐式 using。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
