{
  "_meta": {
    "name": "Abyss CMF",
    "version": "1.0.0",
    "note": "单一令牌源头。改这里，然后用 design/build_tokens.py 生成 web_frontend/src/tokens.css 与 launcher/Theme/{Dark,Light}.xaml。不要直接改生成物。",
    "source": "CMF 印象卡（#FA063E 红强调 + 五色标签 + 背景中性阶梯）+ Codex 亮色实测",
    "form": "锐边 / 斜切 / 圆角 —— 见 form 段"
  },

  "form": {
    "_note": "radius=圆角，chamfer=斜切角（clip-path / WPF Path 用），borderWidth=描边",
    "radius": {
      "none": 0,
      "xs": 2,
      "sm": 4,
      "md": 6,
      "lg": 10,
      "xl": 14,
      "pill": 999
    },
    "chamfer": {
      "sm": 4,
      "md": 8,
      "lg": 14
    },
    "borderWidth": {
      "hair": 1,
      "thick": 2
    },
    "space": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 32
    }
  },

  "typography": {
    "_note": "字体栈两端共用同一份声明顺序；Inter/JetBrains Mono 缺失时回退系统字体。",
    "sans": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "sans-serif"],
    "mono": ["JetBrains Mono", "Fira Code", "ui-monospace", "Cascadia Code", "Consolas", "monospace"],
    "size": {
      "xs": 11,
      "sm": 12,
      "md": 13,
      "base": 14,
      "lg": 15,
      "xl": 18,
      "2xl": 22
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },

  "themes": {
    "dark": {
      "_note": "中性阶梯取自 CMF 卡背景实测（#181818→#333333），#404040 按卡面标注保留为强调档；文字阶取自卡片副标题区实测。",
      "colorScheme": "dark",

      "bg-app": "#181818",
      "bg-sunken": "#141414",
      "bg-surface": "#1E1E1E",
      "bg-elevated": "#262626",
      "bg-raised": "#2C2C2C",
      "bg-hover": "#333333",
      "bg-active": "#3A3A3A",
      "bg-peak": "#404040",
      "bg-overlay": "rgba(0,0,0,0.62)",

      "border-subtle": "#262626",
      "border-default": "#333333",
      "border-strong": "#4D4D4D",

      "text-primary": "#FFFFFF",
      "text-secondary": "#C9C9C9",
      "text-tertiary": "#939393",
      "text-disabled": "#5C5C5C",
      "text-on-accent": "#FFFFFF",

      "accent": "#FA063E",
      "accent-hover": "#FF1F52",
      "accent-active": "#D90536",
      "accent-soft": "rgba(250,6,62,0.14)",
      "accent-ring": "rgba(250,6,62,0.35)",

      "tag-info": "#40B0FF",
      "tag-success": "#7DD043",
      "tag-warning": "#FF991C",
      "tag-danger": "#FF1B23",
      "tag-special": "#FF7EB3",

      "_tooltip-note": "悬停提示是反相气泡：亮色系用近黑底，暗色系用抬高的深灰底，两种主题下都要盖住内容",
      "tooltip-bg": "#404040",
      "tooltip-fg": "#FFFFFF",

      "shadow-1": "0 1px 2px rgba(0,0,0,0.45)",
      "shadow-2": "0 2px 6px rgba(0,0,0,0.55), 0 1px 2px rgba(0,0,0,0.40)",
      "shadow-3": "0 8px 24px rgba(0,0,0,0.65), 0 2px 6px rgba(0,0,0,0.45)"
    },

    "light": {
      "_note": "同一中性系的翻转：#1A1A1A 在暗色是最深底、在亮色改作正文色。面板阶取自 Codex 亮色实测；强调色保持 CMF 的红。标签色为在白底上达标而压暗。",
      "colorScheme": "light",

      "bg-app": "#FFFFFF",
      "bg-sunken": "#F7F7F8",
      "bg-surface": "#FBFBFC",
      "bg-elevated": "#F3F3F5",
      "bg-raised": "#FFFFFF",
      "bg-hover": "#EEEFF0",
      "bg-active": "#E9EAEA",
      "bg-peak": "#E4E4E7",
      "bg-overlay": "rgba(0,0,0,0.32)",

      "border-subtle": "#ECECEE",
      "border-default": "#E4E4E7",
      "border-strong": "#D4D4D8",

      "text-primary": "#1A1A1A",
      "text-secondary": "#626365",
      "text-tertiary": "#89898D",
      "text-disabled": "#B4B4B8",
      "text-on-accent": "#FFFFFF",

      "accent": "#FA063E",
      "accent-hover": "#E00538",
      "accent-active": "#C00430",
      "accent-soft": "rgba(250,6,62,0.10)",
      "accent-ring": "rgba(250,6,62,0.28)",

      "tag-info": "#0B7FD4",
      "tag-success": "#4C9A16",
      "tag-warning": "#C46A00",
      "tag-danger": "#E00A18",
      "tag-special": "#D6337A",

      "tooltip-bg": "#1A1A1A",
      "tooltip-fg": "#FFFFFF",

      "shadow-1": "0 1px 2px rgba(16,16,20,0.06)",
      "shadow-2": "0 2px 6px rgba(16,16,20,0.10), 0 1px 2px rgba(16,16,20,0.06)",
      "shadow-3": "0 8px 24px rgba(16,16,20,0.14), 0 2px 6px rgba(16,16,20,0.08)"
    }
  }
}
