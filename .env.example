# Abyss Core 环境变量模板（复制为 .env.dev 后填值；.env.dev 永不入库）
# 所有变量都有代码内默认值，不写 = 用默认。改完重启对应进程生效。

# ---- 全新源码组件的身份（首次启动器设置可填写，无需修改 Python）----
# MASTER_ID=                 （你的 QQ 号）
# MASTER_NAME=主人
# ASSISTANT_QQ=              （助手登录的 QQ 号）
# ASSISTANT_NAME=助手

# ---- LLM 接入点 key（必填项：无 key 时 LLM 调用会鉴权失败）----
# opencode 统一接入点
OPENCODE_API_KEY=
# 火山方舟（北京）套餐接入点 /api/plan/v3：主力 flash / pro 共用
# （vision / embed 可各自覆盖，见下方 VISION_* / VECTOR_*；留空即回退本 key）
FLASH_API_KEY=

# ---- 运行模式（管理服务读取；只影响 core / ingress 的启动方式）----
# ABYSS_RUN_MODE=source      （source = 核心与信息收发跑仓库源码，改后端重启即生效，无需重打包；
#                              不写 = 冻结管理服务拉起 exe 旁的 core.exe / ingress.exe）

# ---- OneBot 平台（QQ，SnowLuma/NapCat 连入）----
# ONEBOT_ENABLED=true
# ONEBOT_WS_HOST=127.0.0.1
# ONEBOT_WS_PORT=5001
# ONEBOT_WS_PATH=/onebot/v11/ws
# ONEBOT_ACCESS_TOKEN=test-token-123
# INGRESS_API_PORT=5003       （本机接入 API；与 OneBot/Web 端口不同）

# ---- 通用 HTTP 桥接（首个实现为微信文字；默认关闭）----
# BRIDGE_ENABLED=false
# BRIDGE_CONNECTION_ID=bridge
# BRIDGE_BASE_URL=http://127.0.0.1:8770
# BRIDGE_TOKEN=              （启用前必填；桥接端需支持约定的鉴权和能力检查）
# 平台设置在「系统 → 平台接入」中编辑。保存后重启 ingress 与 Core。
# 微信会话锁由桥接程序管理，Core 不调用 focus/lock/unlock。

# ---- Pi 微信隧道（ssh -L 端口转发；由管理服务托管，与 SnowLuma 同级）----
# BRIDGE_TUNNEL_ENABLED=false   （true 时总览多出「Pi 隧道」一行，可启停/查看状态）
# BRIDGE_TUNNEL_PI_HOST=192.168.1.50            （树莓派在内网的地址）
# BRIDGE_TUNNEL_PI_USER=pi                      （树莓派上的登录用户名）
# BRIDGE_TUNNEL_KEY_PATH=%USERPROFILE%\.ssh\pi_ed25519   （支持环境变量，可含空格）
# BRIDGE_TUNNEL_REMOTE_PORT=8770
# 本地转发端口取自 BRIDGE_BASE_URL。隧道只转发端口，协议与微信驱动都在 Pi 上。

# ---- Web 平台（浏览器前端）----
# WEB_ENABLED=true
# WEB_WS_HOST=127.0.0.1
# WEB_WS_PORT=5002
# WEB_WS_PATH=/web/ws
# WEB_ACCESS_TOKEN=          （空 = 不鉴权）

# ---- main.py 监听 ----
# MAIN_HOST=127.0.0.1
# MAIN_PORT=5000

# ---- 日志系统 ----
# LOG_LEVEL=INFO              （DEBUG/INFO/WARNING/ERROR/CRITICAL；DEBUG 会放开第三方库噪声）
# LOG_MAX_BYTES=10485760      （单个日志文件上限，默认 10MB，超出即轮转）
# LOG_BACKUP_COUNT=7          （轮转保留的备份份数）
# LOG_RETENTION_DAYS=7        （启动期清理早于该天数的历史日志：app_*.log、core_stdout.log、manager/*.out.log）
# LOG_GLOBAL_FILE=1           （是否写 app_*.log 总日志；ingress 子进程由管理服务注入 0 关闭）
# SEPARATE_LOG_MODULES=       （逗号分隔，为这些 logger 额外落独立文件）

# ---- LLM 接入点 URL 与模型名 ----
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# FLASH_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# CONVERSATION_API_KEY=
# CONVERSATION_BASE_URL=
# PERSONA_API_KEY=
# PERSONA_BASE_URL=
# VISION_API_KEY=            （留空回退 FLASH_API_KEY）
# VISION_BASE_URL=           （留空回退 FLASH_BASE_URL）
# VECTOR_API_KEY=            （留空回退 FLASH_API_KEY，再回退 OPENCODE_API_KEY）
# VECTOR_BASE_URL=           （留空回退 FLASH_BASE_URL）
# LLM_FLASH=DeepSeek-V4.1-Flash
# LLM_CONVERSATION=       （留空使用 LLM_FLASH）
# LLM_PERSONA=            （留空使用 LLM_FLASH）
# LLM_PRO=                （留空使用 LLM_FLASH）
# LLM_VISION=             （留空使用 LLM_FLASH）
# LLM_EMBEDDING=doubao-embedding-vision
