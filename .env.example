# Abyss Core 环境变量模板（复制为 .env.dev 后填值；.env.dev 永不入库）
# 所有变量都有代码内默认值，不写 = 用默认。改完重启对应进程生效。

# ---- LLM 接入点 key（必填项：无 key 时 LLM 调用会鉴权失败）----
# opencode 统一接入点
OPENCODE_API_KEY=
# 火山方舟（北京）coding 接入点：主力 flash / vision / pro / embedding 共用
FLASH_API_KEY=

# ---- OneBot 平台（QQ，SnowLuma/NapCat 连入）----
# ONEBOT_ENABLED=true
# ONEBOT_WS_HOST=127.0.0.1
# ONEBOT_WS_PORT=5001
# ONEBOT_WS_PATH=/onebot/v11/ws
# ONEBOT_ACCESS_TOKEN=test-token-123
# INGRESS_API_PORT=5003       （本机接入 API；与 OneBot/Web 端口不同）

# ---- Web 平台（浏览器前端）----
# WEB_ENABLED=true
# WEB_WS_HOST=127.0.0.1
# WEB_WS_PORT=5002
# WEB_WS_PATH=/web/ws
# WEB_ACCESS_TOKEN=          （空 = 不鉴权）

# ---- main.py 监听 ----
# MAIN_HOST=127.0.0.1
# MAIN_PORT=5000

# ---- LLM 接入点 URL 与模型名 ----
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# FLASH_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# CONVERSATION_API_KEY=
# CONVERSATION_BASE_URL=
# PERSONA_API_KEY=
# PERSONA_BASE_URL=
# LLM_FLASH=deepseek-v4.1-flash
# LLM_CONVERSATION=deepseek-v4.1-flash
# LLM_PERSONA=deepseek-v4.1-flash
# LLM_PRO=
# LLM_VISION=deepseek-v4.1-flash
# LLM_EMBEDDING=doubao-embedding-vision
